{
    "name": "alc/opml-parser",
    "type": "library",   
    "description": "A small PHP library to read and write OPML files, the format feed readers use to import and export lists of RSS/Atom subscriptions.",
    "keywords": ["opml", "parser", "reader", "writer", "rss", "atom", "feed", "xml"],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Alc\\Opml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alc\\Opml\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Alexis CHEMEL",
            "email": "chemel@users.noreply.github.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
        "ext-libxml": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
